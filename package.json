{
  "name": "zentra",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/desktop",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev -- --host 127.0.0.1",
    "build": "npm --workspace apps/web run build",
    "dev:api": "python3 -m uvicorn app.main:app --app-dir services/api --host 127.0.0.1 --port 8000 --reload",
    "dev:desktop": "npm --workspace apps/desktop run dev",
    "build:desktop": "npm --workspace apps/desktop run build",
    "start:desktop": "npm --workspace apps/desktop run start",
    "start:all": "node scripts/start-local.js",
    "setup:ide": "node scripts/setup-ide.cjs",
    "start:ide": "node scripts/start-ide.cjs",
    "test:ide": "node --test apps/ide-extension/test/*.test.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
