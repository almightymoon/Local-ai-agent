{
  "name": "local-ai-agent",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/desktop",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev -- --host 0.0.0.0",
    "build": "npm --workspace apps/web run build",
    "dev:api": "python3 -m uvicorn app.main:app --app-dir services/api --host 0.0.0.0 --port 8000 --reload",
    "dev:desktop": "npm --workspace apps/desktop run dev",
    "build:desktop": "npm --workspace apps/desktop run build",
    "start:desktop": "npm --workspace apps/desktop run start",
    "start:all": "node scripts/start-local.js"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
