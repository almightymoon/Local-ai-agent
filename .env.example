# Voice / STT (local Faster Whisper)
STT_PROVIDER=faster-whisper
WHISPER_MODEL=medium.en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=false
# Accuracy ladder: tiny.en < base.en < small.en < medium.en < large-v3
# Faster (less accurate): WHISPER_MODEL=small.en
# Optional vocabulary bias for product / coding terms:
# WHISPER_INITIAL_PROMPT=Zentra is a local AI coding agent.
# Optional: path for extra voice debug logs (defaults to stdout logger only)
# VOICE_LOG_PATH=
# STT_MAX_UPLOAD_BYTES=26214400

# Voice / TTS
# edge = free neural voices (best quality; needs network) — recommended
# piper = fully local open-source offline TTS
# mock = tests only
TTS_PROVIDER=edge
TTS_VOICE=en-US-JennyNeural
TTS_RATE=+40%
# Other strong free voices: en-US-AriaNeural, en-US-GuyNeural, en-GB-SoniaNeural
# Faster still: TTS_RATE=+55%   Slower: TTS_RATE=+15%
# PIPER_VOICE=en_US-lessac-medium
# PIPER_MODEL_DIR=

# Ollama / LLM
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Other
DB_PATH=
